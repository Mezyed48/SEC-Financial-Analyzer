# SEC EDGAR User-Agent Configuration Template
# To use this in production or when sharing code on GitHub:
# 1. Copy this file to '.streamlit/secrets.toml'
# 2. Fill in your name, university/organization, and email address below.
# 3. Note that '.streamlit/secrets.toml' is ignored by .gitignore to protect your privacy.

SEC_USER_ORGANIZATION = "Your University or Organization"
SEC_USER_NAME = "Your Name"
SEC_USER_EMAIL = "your_email@university.edu"
